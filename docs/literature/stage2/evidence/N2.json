{"data":{"id":"10.48550/arxiv.2105.03427","type":"dois","attributes":{"doi":"10.48550/arxiv.2105.03427","prefix":"10.48550","suffix":"arxiv.2105.03427","identifiers":[{"identifier":"2105.03427","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2105.03427"}],"creators":[{"name":"Köhler, Johannes","nameType":"Personal","givenName":"Johannes","familyName":"Köhler","affiliation":[],"nameIdentifiers":[]},{"name":"Müller, Matthias A.","nameType":"Personal","givenName":"Matthias A.","familyName":"Müller","affiliation":[],"nameIdentifiers":[]},{"name":"Allgöwer, Frank","nameType":"Personal","givenName":"Frank","familyName":"Allgöwer","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust output feedback model predictive control using online estimation bounds"}],"publisher":"arXiv","container":{},"publicationYear":2021,"subjects":[{"lang":"en","subject":"Systems and Control (eess.SY)","subjectScheme":"arXiv"},{"lang":"en","subject":"Optimization and Control (math.OC)","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2021-05-07T17:59:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2021-05-10T00:20:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2021-05","dateType":"Available","dateInformation":"v1"},{"date":"2021","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"We present a framework to design nonlinear robust output feedback model predictive control (MPC) schemes that ensure constraint satisfaction under noisy output measurements and disturbances. We provide novel estimation methods to bound the magnitude of the estimation error based on: stability properties of the observer; detectability; set-membership estimation; moving horizon estimation (MHE). Robust constraint satisfaction is guaranteed by suitably incorporating these online validated bounds on the estimation error in a homothetic tube based MPC formulation. In addition, we show how the performance can be further improved by combining MHE and MPC in a single optimization problem. The framework is applicable to a general class of detectable and (incrementally) stabilizable nonlinear systems. While standard output feedback MPC schemes use offline computed worst-case bounds on the estimation error, the proposed framework utilizes online validated bounds, thus reducing conservatism and improving performance. We demonstrate the reduced conservatism of the proposed framework using a nonlinear 10-state quadrotor example.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2105.03427","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2022-02-21T20:42:24.000Z","registered":"2022-02-21T20:42:25.000Z","published":"2021","updated":"2022-02-21T20:42:25.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2105.03427","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}